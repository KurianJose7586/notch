{
  "name": "agent-notch",
  "version": "0.3.1",
  "private": true,
  "main": "boot.js",
  "scripts": {
    "start": "electron .",
    "test": "node state.js && node launch.js && node phone.js && node updater.js && node position.js",
    "setup": "npm install && node setup.js && electron .",
    "install-hooks": "node setup.js",
    "remove-hooks": "node setup.js --remove",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "description": "A Dynamic-Island-style notch that tracks and manages your coding agents",
  "build": {
    "appId": "dev.agentnotch.app",
    "productName": "Agent Notch",
    "executableName": "agent-notch",
    "asar": false,
    "files": [
      "boot.js",
      "main.js",
      "hook.js",
      "state.js",
      "launch.js",
      "setup.js",
      "plugin.js",
      "preload.js",
      "index.html",
      "win.ps1",
      "phone.js",
      "phone.html",
      "updater.js",
      "position.js"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "build/installer.nsh",
      "shortcutName": "Agent Notch",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "AgentNotch-Setup-${version}.${ext}"
    },
    "extraFiles": [
      {
        "from": "build/notch-hook.cmd",
        "to": "notch-hook.cmd"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "KurianJose7586",
        "repo": "notch"
      }
    ]
  },
  "author": "Kurian Jose",
  "repository": {
    "type": "git",
    "url": "https://github.com/KurianJose7586/notch.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "qrcode-generator": "^2.0.4"
  },
  "license": "MIT"
}
